#!/usr/bin/env php
<?php
/**
 * @name yaf_cg
 * @desc Yaf application skeleton code generator.
 *
 * Generates a full, ready-to-run Yaf application layout that mirrors the
 * "Quick Start" tutorial of the Yaf manual: a public/ entry directory, an
 * INI configuration file, a Bootstrap with every hook explained, default /
 * error / custom-route controllers, a sample model, a plugin demonstrating
 * all six dispatch hooks, and view templates.
 *
 * Every generated method carries a comment describing what it is for, so the
 * skeleton doubles as runnable documentation.
 *
 * @author Wei He (he_wei@baidu.com)
 * @author Laruence (laruence@baidu.com)
 */

$options = getOpt("a:d:nhf", array("namespace", "directory:", "app", "help", "force"));

if (isset($options["h"]) || isset($options["help"]) || empty($options)) {
    die(<<<HELP
Usage: yaf_cg [-a ApplicationName] [-d ApplicationPath] [-n] [-f]

POSIX options:  GNU long options:    Meaning:
      -a          --app              Application Name, default yaf_skeleton
      -d          --directory        Output directory, default ./<ApplicationName>
      -n          --namespace        Use the namespace class style (Yaf\Application)
      -f          --force            Overwrite the output directory if it already exists
      -h          --help             Print this usage

Examples:
      ./yaf_cg -a Sample -d /tmp/sample
      ./yaf_cg -a Sample -n          # namespace style, into ./Sample

HELP
    );
}

if (!isset($options["a"]) && !isset($options["app"])) {
	$appname = "yaf_skeleton";
} else {
	$appname = isset($options["a"]) ? strval($options["a"]) : strval($options["app"]);
}

if (!isset($options["d"]) && !isset($options["directory"])) {
	$directory = __DIR__ . "/" . $appname;
} else {
	$directory = isset($options["d"]) ? strval($options["d"]) : strval($options["directory"]);
}

if (!isset($options["n"]) && !isset($options["namespace"])) {
	$use_namespace = 0;
} else {
	$use_namespace = 1;
}

$force = isset($options["f"]) || isset($options["force"]);

if (file_exists($directory) && !$force) {
	// The directory already exists and -f was not given; abort rather
	// than overwrite user files.
	exit("Error: {$directory} already exists. Use -f to overwrite.\n");
}

echo "Outputting", $use_namespace ? " Namespaced" : "", " Yaf Skeleton to {$directory}\n";

$author   = trim(shell_exec("whoami") ?: "unknown");
$hostname = trim(shell_exec("hostname") ?: "localhost");

$conf = array (
	'author'     => $author,          // developer, written into @author of generated files
	'app_name'   => $appname,         // application name, must also be a valid directory name
	'directory'  => $directory,       // output directory
	'namespace'  => $use_namespace,   // use namespace class style (Yaf_Application -> \Yaf\Application)
	'dev_pc'     => $author . '@' . $hostname, // dev machine, written into the README
);

generateSkeleton($conf);

function generateSkeleton($conf) {
	$skeletons = getTemplates(__DIR__ . "/templates/");
	processTemplates($skeletons, $conf);
	processOutput($conf["directory"], $skeletons);
}

function processTemplates(&$skeletons, $conf) {
	foreach ($skeletons as $k => &$v) {
		if (is_array($v)) {
			processTemplates($v, $conf);
		} else if (substr($k, -7) != "ini.tpl") {
			$v = str_replace(
				array(
					'{&$AUTHOR&}',
					'{&$APP_NAME&}',
					'{&$DEV_PC&}'
				),
				array(
					$conf["author"],
					$conf["app_name"],
					$conf["dev_pc"]
				),
				$v);

			if ($conf["namespace"]) {
				// Rewrite underscore-style class names into namespace style
				// (every Yaf_* class appearing in generated files is replaced).
				$v = str_replace(
					array(
						"Yaf_Application",
						"Yaf_Dispatcher",
						"Yaf_Bootstrap_Abstract",
						"Yaf_Controller_Abstract",
						"Yaf_Action_Abstract",
						"Yaf_Plugin_Abstract",
						"Yaf_Request_Http",
						"Yaf_Request_Simple",
						"Yaf_Request_Abstract",
						"Yaf_Response_Http",
						"Yaf_Response_Cli",
						"Yaf_Response_Abstract",
						"Yaf_Registry",
						"Yaf_Router",
						"Yaf_Route_Interface",
						"Yaf_Route_Static",
						"Yaf_Route_Rewrite",
						"Yaf_Route_Regex",
						"Yaf_Route_Simple",
						"Yaf_Route_Supervar",
						"Yaf_Route_Map",
						"Yaf_View_Simple",
						"Yaf_View_Interface",
						"Yaf_Loader",
						"Yaf_Session",
						"Yaf_Config_Abstract",
						"Yaf_Config_Ini",
						"Yaf_Config_Simple",
						"Yaf_Exception_LoadFailed_Module",
						"Yaf_Exception_LoadFailed_Controller",
						"Yaf_Exception_LoadFailed_Action",
						"Yaf_Exception_LoadFailed_View",
						"Yaf_Exception",
					),
					array(
						"\\Yaf\\Application",
						"\\Yaf\\Dispatcher",
						"\\Yaf\\Bootstrap_Abstract",
						"\\Yaf\\Controller_Abstract",
						"\\Yaf\\Action_Abstract",
						"\\Yaf\\Plugin_Abstract",
						"\\Yaf\\Request\\Http",
						"\\Yaf\\Request\\Simple",
						"\\Yaf\\Request_Abstract",
						"\\Yaf\\Response\\Http",
						"\\Yaf\\Response\\Cli",
						"\\Yaf\\Response_Abstract",
						"\\Yaf\\Registry",
						"\\Yaf\\Router",
						"\\Yaf\\Route_Interface",
						"\\Yaf\\Route_Static",
						"\\Yaf\\Route\\Rewrite",
						"\\Yaf\\Route\\Regex",
						"\\Yaf\\Route\\Simple",
						"\\Yaf\\Route\\Supervar",
						"\\Yaf\\Route\\Map",
						"\\Yaf\\View\\Simple",
						"\\Yaf\\View_Interface",
						"\\Yaf\\Loader",
						"\\Yaf\\Session",
						"\\Yaf\\Config_Abstract",
						"\\Yaf\\Config\\Ini",
						"\\Yaf\\Config\\Simple",
						"\\Yaf\\Exception\\LoadFailed\\Module",
						"\\Yaf\\Exception\\LoadFailed\\Controller",
						"\\Yaf\\Exception\\LoadFailed\\Action",
						"\\Yaf\\Exception\\LoadFailed\\View",
						"\\Yaf\\Exception",
					),
					$v);
			}
			$skeletons[$k] = $v;
		}
	}
}

function processOutput($directory, $skeletons) {
	if (!file_exists($directory)) {
		if (false === mkdir($directory, 0755, true)) {
			exit("Error: {$directory} cannot be created\n");
		}
	}

	foreach ($skeletons as $k => $v) {
		if (is_array($v)) {
			@mkdir($directory . "/" . $k, 0755, true);
			processOutput($directory . "/" . $k, $skeletons[$k]);
		} else {
			// Strip the trailing ".tpl" from the file name and write it
			// out; assets that carry no ".tpl" suffix (e.g. images) are
			// copied under their original name.
			$name = (substr($k, -4) == ".tpl") ? substr($k, 0, -4) : $k;
			file_put_contents($directory . "/" . $name, $v);
		}
	}
}

function getTemplates($root, &$templates = NULL) {
	$dir = opendir($root);
	if ($dir === false) {
		exit("Error: {$root} does not exist\n");
	}
	if ($templates === NULL) {
		$templates = array();
	}
	while ($entry = readdir($dir)) {
		// Skip only the two special directory entries "." and ".."; do
		// not test the first character, or dotfiles like ".htaccess"
		// would be silently skipped.
		if ($entry == "." || $entry == "..") {
			continue;
		}
		if (!is_dir($root . $entry)) {
			$templates[$entry] = file_get_contents($root . $entry);
		} else {
			$templates[$entry] = array();
			getTemplates($root . $entry . "/", $templates[$entry]);
		}
	}
	closedir($dir);
	return $templates;
}

echo "Generating done\n";
echo "\n";
echo "Quick try without a web server:\n";
echo "  php -S 127.0.0.1:8000 -t {$conf["directory"]}/public {$conf["directory"]}/router.php\n";
echo "then browse http://127.0.0.1:8000/\n";
?>
